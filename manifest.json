{
    "manifest_version": 3,
    "name": "Fynn New Tab",
    "version": "0.1.0",
    "description": "A customizable cinematic new tab for Brave.",
    "chrome_url_overrides": {
        "newtab": "newtab/index.html"
    },
    "permissions": ["unlimitedStorage"],
    "icons": {
    "16": "assets/images/fynn-icon.png",
    "48": "assets/images/fynn-icon.png",
    "128": "assets/images/fynn-icon.png"
    },
    "action": {
    "default_icon": "assets/images/fynn-icon.png"
    }
}